# ============================================================================
# India 3D ULPIN — environment template
# Copy to `.env` and fill values. NEVER commit real secrets.
# ============================================================================

# --- General ---
APP_ENV=development            # development | production | test
DEBUG=false
PROJECT_NAME=India 3D ULPIN
API_V1_PREFIX=/api/v1

# --- Database ---
# SQLite (default, no external service needed for demo/tests):
DATABASE_URL=sqlite:///./data/3dulpin.db
# PostgreSQL + PostGIS (production / docker-compose):
# DATABASE_URL=postgresql+psycopg://3dulpin:3dulpin@db:5432/3dulpin
# Note: when using PostGIS, set DATABASE_BACKEND=postgis

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_UPLOAD_TYPES=json,jsonl,geojson,glb,gltf,cityjson

# --- Demo seeding (development only) ---
SEED_DEMO_DATA=true
SEED_DEMO_USERS=true
DEMO_LOCALITY_NAME=Bengaluru Pilot Zone (Synthetic)

# --- LLM assistant (OpenRouter) - optional ---
# Leave empty to run fully offline / demo mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- ML models - optional ---
# Enabling requires downloading a pretrained model at runtime.
ML_BUILDING_MODEL_ENABLED=false

# --- Cesium (frontend) ---
# Optional Ion token for world imagery/terrain. Not required for OSM basemap.
VITE_CESIUM_ION_TOKEN=
VITE_API_BASE=http://localhost:8000/api/v1
